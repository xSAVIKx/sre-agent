{
  "name": "sre-agent-chat-a2ui",
  "private": true,
  "description": "Builds the chat UI's A2UI renderer bundle (agent/src/agent/static/sre-a2ui.js).",
  "type": "module",
  "scripts": {
    "build": "esbuild src/sre-a2ui.js --bundle --format=esm --minify --target=es2022 --legal-comments=eof --outfile=../src/agent/static/sre-a2ui.js"
  },
  "dependencies": {
    "@a2ui/lit": "0.12.0",
    "@a2ui/markdown-it": "0.2.0",
    "@a2ui/web_core": "0.12.0",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
